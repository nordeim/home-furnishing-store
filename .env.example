# NORDHEM (home-furnishing-store) — environment configuration
# Copy to .env and adjust. The app degrades to the static catalogue in
# src/lib/catalog.ts when Postgres is unreachable ("Degrade, Never Fail"),
# but orders/checkout/reviews/tracking require a live database.

# ---- Database (required) --------------------------------------------------
# PostgreSQL connection string — the only variable the codebase reads.
# Used by src/db/index.ts (Drizzle ORM + node-postgres pool) and by
# drizzle.config.json's `npx drizzle-kit push` (which pins its own local
# default; update it too if your database moves).
# Local dev default (matches drizzle.config.json):
DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:5432/app_db"

# Notes:
# - No AUTH_SECRET / session secrets: auth is intentionally deferred (demo
#   Family/Business flows, no passwords stored) — see docs/implementation-plan.md.
# - No Stripe/payment keys: payments are mock selectors (card/PayNow/GrabPay/
#   Atome) flagged "Demo — no charge" in the checkout UI.
# - NEXT_PUBLIC_SITE_URL is NOT read by this codebase; the canonical origin
#   https://nordhem.sg is hardcoded in src/app/layout.tsx metadataBase,
#   robots.ts and sitemap.ts.
# - Precedence trap: an exported shell DATABASE_URL beats this file (dotenv
#   never overrides existing env). If the app connects to the wrong DB, check
#   `env | grep DATABASE` and pin the value per command, e.g.
#   `DATABASE_URL="postgresql://…" npm run dev`.

# ---- Site ------------------------------------------------------------------
# Canonical public origin — used for metadata, sitemap.xml, and robots.txt.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ---- Auth ------------------------------------------------------------------
# Session signing secret for the `homenest_session` cookie (HMAC).
# REQUIRED in production: the server REFUSES to start without a strong value
# (the insecure dev fallback throws at module load when NODE_ENV=production).
# Generate with: openssl rand -hex 32
AUTH_SECRET=""

# ---- Demo ------------------------------------------------------------------
# The login page ships a demo-credentials quick-fill box for development
# builds. In PRODUCTION builds the box is OFF by default (it names the seeded
# admin account) — set to "true" to opt back in for an evaluation deploy.
# Leave unset in development to show it; "false" hides it there too.
# Since session-13 the credentials are passed server-side as props only when
# enabled — a default production build ships no credential strings at all.
# NEXT_PUBLIC_DEMO_MODE=true

# ---- Rate limiting ---------------------------------------------------------
# clientIp (the per-IP limiter key) trusts Cloudflare's cf-connecting-ip by
# default. On a DIRECT deployment (no CF edge) that header is client-forgeable
# — set to "false" so it is ignored and the rightmost x-forwarded-for hop (or
# the shared "direct" bucket) is used instead.
# TRUST_CF_CONNECTING_IP="false"

# ---- Stripe payments (the Stripe retrofit, PAY-STRIPE-1) --------------------
# Empty by default: the checkout renders the Cash-on-Delivery flow (the
# reference's only payment method, no charges). With real keys set, a Card
# option joins the payment methods as a real Stripe checkout: a Payment
# Element (PCI SAQ-A — card data never touches this app), a server-minted
# PaymentIntent (amount re-derived from the live cart + coupon + settings),
# and webhook-driven order placement for interrupted checkouts.
#   STRIPE_SECRET_KEY:                     sk_test_… (test mode) or sk_live_…
#   NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY:    pk_test_… / pk_live_…
#   STRIPE_WEBHOOK_SECRET:                 whsec_… from `stripe listen` or the
#                                          dashboard endpoint for
#                                          POST /api/stripe/webhook
# See docs/DEPLOYMENT.md for the full setup (test cards, the local webhook
# listener, and the refund loop).
STRIPE_SECRET_KEY=""
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=""
STRIPE_WEBHOOK_SECRET=""
# REQUIRED to actually enable the Card option: the taka-per-dollar rate the
# PaymentIntent is converted through (Stripe cannot charge BDT). Without a
# valid positive number the Card option stays OFF even with keys set — the
# card path would otherwise mint a USD intent whose amount equals the poisha
# count (a ~120x overcharge). Example: STRIPE_BDT_PER_USD=120 charges
# $2.40 for a ৳288 order. Update it when your pricing FX drifts.
# STRIPE_BDT_PER_USD=120
